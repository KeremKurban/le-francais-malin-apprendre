# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=francais
POSTGRES_PASSWORD=changeme
POSTGRES_DB=francais_malin
DATABASE_URL=postgresql+asyncpg://francais:changeme@db:5432/francais_malin

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-64-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Supabase (frontend auth) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Backend API (accessed by frontend) ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── MLflow ─────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=francais-malin-evaluations

# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
